{
  "name": "dbstudio",
  "version": "0.1.0",
  "private": true,
  "description": "Database browser and SQL editor (DBeaver alternative)",
  "author": "Douzone",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "node scripts/with-node.js vite",
    "dev:electron": "wait-on tcp:5273 && cross-env NODE_ENV=development electron .",
    "build": "node scripts/with-node.js vite build",
    "start": "npm run build && electron .",
    "update": "git pull --ff-only && node scripts/with-node.js npm install && npm start",
    "app": "npm run pack && node scripts/install-app.js",
    "update:app": "git pull --ff-only && node scripts/with-node.js npm install && npm run app",
    "typecheck": "node scripts/with-node.js tsc --noEmit",
    "icons": "node scripts/make-icon.js",
    "pack": "npm run build && node scripts/with-node.js electron-builder --dir",
    "dist": "npm run build && node scripts/with-node.js electron-builder",
    "dist:mac": "npm run build && node scripts/with-node.js electron-builder --mac",
    "dist:win": "npm run build && node scripts/with-node.js electron-builder --win",
    "dist:linux": "npm run build && node scripts/with-node.js electron-builder --linux",
    "mcp": "node mcp/server.js",
    "mcp:init": "node mcp/init.js"
  },
  "build": {
    "appId": "com.douzone.dbstudio",
    "productName": "DB Studio",
    "copyright": "Copyright © 2026 Douzone",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!node_modules/@modelcontextprotocol/**",
      "!node_modules/zod/**",
      "!mcp/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/mysql2/**",
      "**/node_modules/pg/**",
      "**/node_modules/exceljs/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DB Studio"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "exceljs": "^4.4.0",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@codemirror/lang-sql": "^6.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@uiw/react-codemirror": "^4.23.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
